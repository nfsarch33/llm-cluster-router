# Binaries
llm-cluster-router
/helixchannel
# `make build` emits this one (Makefile: go build -o llm-router .). It was not
# listed, so a 23 MB unstripped binary sat untracked in the tree and was one
# `git add -A` away from a public repo.
/llm-router
*.exe

# runx scratch (generated by runx docker-push, etc.)
.runs/

# Config with secrets
router.yml
!router.sample.yml

# Go
vendor/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Test/coverage
coverage.out
*.test

# Benchmark output
*-benchmark.json
*-gpu-probe.json

# Benchmark runs. Only a deliberately-recorded .bench/baseline.txt is tracked;
# every other run is a local artifact (see docs/testing-tiers.md).
.bench/*
!.bench/baseline.txt
