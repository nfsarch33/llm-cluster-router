{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations \u0026 Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "HelixChannel (AES-256-GCM / TLS-edge / SOCKS5) L7 observability. Panels source from llm_cluster_router_* and alert rules in observability/alerts/helixchannel-sessions.yaml + observability/alerts/helixchannel.yaml. Designed for v18729-2 production readiness.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "rate(llm_cluster_router_connections_total[1m]) keyed by {listener, outcome}. Should track baseline traffic; spike in outcome=\"error\" → investigate upstream.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (listener, outcome) (rate(llm_cluster_router_connections_total[1m]))",
          "legendFormat": "{{listener}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Connections /s by listener × outcome",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "histogram_quantile(0.95, sum by (le, listener, model) (rate(llm_cluster_router_request_duration_by_model_seconds_bucket[5m]))). v18729-2 panel — TTFB alert at p95 \u003e 1s for 5min pages via SLO-18729-2.A.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, listener, model) (rate(llm_cluster_router_request_duration_by_model_seconds_bucket[5m])))",
          "legendFormat": "p95 {{listener}} / {{model}}",
          "refId": "A"
        }
      ],
      "title": "TTFB p95 by listener × model",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "rate(llm_cluster_router_decrypt_failed_total[1m]) — any non-zero rate sustained for \u003e1min pages via SLO-18714-3.B (HelixChannelDecryptErrors).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (listener) (rate(llm_cluster_router_decrypt_failed_total[1m]))",
          "legendFormat": "{{listener}}",
          "refId": "A"
        }
      ],
      "title": "Decrypt-failed rate by listener",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "rate(llm_cluster_router_helixchannel_session_total{outcome=\"failure\"}[1m]) — SLO-18714-3.C fires on rate \u003e 1/s sustained 5min. v18729-2 wires Slack + operator email on this alert.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(llm_cluster_router_helixchannel_session_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "5xx-rate / failure outcomes /s",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "count(up{job=\"llm-cluster-router\"} == 1) — operator eye-candy; should be ≥ 1 in production.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "count(up{job=\"llm-cluster-router\"} == 1)",
          "refId": "A"
        }
      ],
      "title": "Active listeners up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "sum(rate(llm_cluster_router_bytes_total[1m])) — capacity-planning signal.",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_cluster_router_bytes_total[1m]))",
          "refId": "A"
        }
      ],
      "title": "Bytes/s proxied",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "histogram_quantile(0.95, sum by (le) (rate(llm_cluster_router_request_duration_seconds_bucket[5m]))). Operator alarm when \u003e 1s for \u003e 5min.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_cluster_router_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "title": "TTFB p95 (global)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Should be 0 in steady state; non-zero triggers HelixChannelDecryptErrors page.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(llm_cluster_router_decrypt_failed_total[1m]))",
          "refId": "A"
        }
      ],
      "title": "Decrypt-failed rate (1m avg)",
      "type": "stat"
    }
  ],
